# ========== KẾT NỐI – Copy thành .env khi deploy VPS / chạy máy ==========
# cp .env.example .env

# Binance: CHỈ LẤY GIÁ từ API công khai (https://fapi.binance.com) – không cần bật profile/API key.
# Paper trade chạy trên code (VPS/máy), không dùng chương trình paper trade của Binance.
# Chỉ điền key khi sau này bật trade thật (đặt lệnh trên sàn).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram cho paper trade (token từ @BotFather). Không commit token thật lên git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuỳ chọn: true = dùng Binance Testnet (khi trade thật)
# BINANCE_TESTNET=false

# Tuỳ chọn: true = không đặt lệnh thật
# DRY_RUN=false

# ========== TRADE THẬT (trang /live) ==========
# Bắt buộc: mật khẩu đăng nhập trang /live (tài khoản sàn, Telegram, bot đều nhập trên web, không cần sửa code).
LIVE_ADMIN_PASSWORD=
# Tuỳ chọn: khoá mã hoá API key (Fernet). Để trống = tự tạo file data/live/secret.key lần chạy đầu.
# LIVE_SECRET_KEY=
# Tuỳ chọn: true nếu web chạy qua HTTPS (nginx + certbot) để cookie đăng nhập chỉ gửi qua HTTPS.
# WEB_COOKIE_SECURE=false
