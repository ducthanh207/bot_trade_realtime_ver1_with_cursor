# ========== KẾT NỐI – Copy thành .env khi deploy VPS / chạy máy ==========
# cp .env.example .env

# Binance: CHỈ LẤY GIÁ từ API công khai (https://fapi.binance.com) – không cần bật profile/API key.
# Paper trade chạy trên code (VPS/máy), không dùng chương trình paper trade của Binance.
# Chỉ điền key khi sau này bật trade thật (đặt lệnh trên sàn).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram cho paper trade (token từ @BotFather). Không commit token thật lên git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tuỳ chọn: true = dùng Binance Testnet (khi trade thật)
# BINANCE_TESTNET=false

# Tuỳ chọn: true = không đặt lệnh thật
# DRY_RUN=false

# ========== TRADE THẬT (trang /live) ==========
# Bắt buộc: mật khẩu đăng nhập trang /live (tài khoản sàn, Telegram, bot đều nhập trên web, không cần sửa code).
LIVE_ADMIN_PASSWORD=
# Tuỳ chọn: khoá mã hoá API key (Fernet). Để trống = tự tạo file data/live/secret.key lần chạy đầu.
# LIVE_SECRET_KEY=
# Tuỳ chọn: true nếu web chạy qua HTTPS (nginx + certbot) để cookie đăng nhập chỉ gửi qua HTTPS.
# WEB_COOKIE_SECURE=false

# ========== [2026-11-01] PP4: nhận diện giai đoạn + cắt lỗ sớm (mặc định TẮT) ==========
# Giải thích: docs/PP4_REGIME_EARLY_CUT.md — chỉ bật sau khi backtest cho kết quả tốt hơn.
# M4_REGIME_ENABLED=false          # phân loại UP/DOWN/RANGE; lệnh RANGE/ngược trend dùng stop chặt
# M4_REGIME_LOOKBACK=20            # số nến 4H để đo
# M4_REGIME_ER_TREND=0.2           # ER >= ngưỡng → có trend
# M4_REGIME_SLOPE_ATR=1.0          # độ dốc EMA50 tối thiểu (số lần ATR 4H)
# M4_TIGHT_ATR_MULTIPLIER=1.5      # hệ số ATR cho lệnh "chặt"
# M4_RANGE_SKIP_ENTRY=false        # (E) bỏ lệnh khi RANGE
# M4_COUNTER_TREND_BLOCK=false     # chặn lệnh ngược trend
# M4_INVALIDATION_EXIT=false       # (A) thoát khi nến 1H phá đáy/đỉnh nến 4H tín hiệu
# M4_INVALIDATION_HOURS=12
# M4_INVALIDATION_BUFFER_ATR=0.3
# M4_TIME_STOP=false               # (B) sau N giờ vẫn lỗ → đóng ở mốc 4H
# M4_TIME_STOP_HOURS=4
# M4_EARLY_CUT_ONLY_TIGHT=true     # A/B chỉ áp cho lệnh "chặt"
# M4_SMOOTH_GRACE=false            # (D) hệ số ATR giảm dần 2.5→2.2 trong 12h
